# Gerado por envsubst ao subir o container (imagem oficial do nginx): só ${MIXTAPE_API_UPSTREAM} e
# ${MIXTAPE_PUBLIC_URL} são trocados; variáveis do nginx como $uri ficam como estão. O site em si (locations)
# está em site.conf.template, incluído pelos dois `server` abaixo.

# Capas servidas pela API (proxy do Cover Art Archive): cópia em disco aqui, na frente dela. 1 GB,
# e o que ninguém pedir em 30 dias sai.
proxy_cache_path /var/cache/nginx/covers levels=1:2 keys_zone=covers:10m max_size=1g inactive=30d use_temp_path=off;

# HSTS só quando o proxy da frente (TLS) avisa que o navegador chegou por https. Em http puro, como
# no localhost, o cabeçalho fica de fora (vazio, o nginx não manda); o navegador o ignoraria de todo jeito.
map $http_x_forwarded_proto $mixtape_hsts {
    default "";
    https "max-age=31536000";
}

# Na porta do túnel, a borda da Cloudflare sempre avisa o protocolo; sem aviso, foi https (a borda só fala https).
map $http_x_forwarded_proto $mixtape_edge_proto {
    default https;
    http http;
}

# Robôs de busca e de prévia de link recebem o <head> da página montado pela API (SSI no index.html).
map $http_user_agent $mixtape_seo_bot {
    default "";
    "~*(googlebot|google-inspectiontool|storebot-google|bingbot|yandex|baiduspider|duckduckbot|slurp|applebot|petalbot|facebookexternalhit|facebookcatalog|meta-externalagent|twitterbot|linkedinbot|pinterest|redditbot|slackbot|discordbot|telegrambot|whatsapp|skypeuripreview|embedly|iframely|vkshare|tumblr|mastodon|bluesky|cardyb|ia_archiver)" "1";
}

# Porta publicada na máquina (WEB_PORT): navegador local, testes e ferramentas. O IP de quem chama é o da conexão;
# CF-Connecting-IP e X-Forwarded-For mandados pelo cliente não valem aqui.
server {
    listen 8080;
    listen [::]:8080;
    server_name _;
    set $mixtape_proto $scheme;
    include /etc/nginx/conf.d/mixtape/site.conf;
}

# Porta do túnel da Cloudflare (serviço cloudflared do compose). Ela NÃO é publicada: só quem está na rede do compose
# (o cloudflared) chega aqui, e por isso o CF-Connecting-IP, que a borda da Cloudflare preenche com o IP de quem
# abriu o site, é aceito vindo da rede interna do Docker. Nunca publique esta porta: publicada, qualquer um
# escolheria o próprio IP para os limites da API.
server {
    listen 8081;
    listen [::]:8081;
    server_name _;
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    set_real_ip_from fc00::/7;
    real_ip_header CF-Connecting-IP;
    set $mixtape_proto $mixtape_edge_proto;
    include /etc/nginx/conf.d/mixtape/site.conf;
}
