# Copie para .env e ajuste. O .env fica fora do git e da imagem Docker.

# Porta do front na máquina (container nginx).
WEB_PORT=5180

# Onde o nginx do container encontra a API. Com o compose da API rodando na mesma máquina, é a
# porta que ele publica (API_PORT do .env da API).
MIXTAPE_API_UPSTREAM=http://host.docker.internal:3001

# Endereço público do front, sem barra no final (vai no robots.txt para apontar o sitemap).
MIXTAPE_PUBLIC_URL=http://localhost:5180

# Onde o Vite encontra a API em `npm run dev` (o navegador fala só com o Vite, mesma origem).
MIXTAPE_DEV_API=http://localhost:3001

# Contato exibido na política de privacidade e nos termos (opcional; vazio mostra um texto genérico).
VITE_CONTACT_EMAIL=

# Cloudflare (ver cloudflare/README.md). O túnel só sobe com o perfil: COMPOSE_PROFILES=cloudflare.
# O token é gravado aqui pelo `npm run edge:apply -- --write-env` (ou copie do painel: Zero Trust > Networks >
# Tunnels). Segredo: quem tem o token publica qualquer coisa no host do túnel.
# COMPOSE_PROFILES=cloudflare
CLOUDFLARE_TUNNEL_TOKEN=

# Testes de interface (npm run test:e2e). O Playwright não lê este arquivo: exporte no terminal.
# Sem E2E_EMAIL e E2E_PASSWORD, cada rodada cria uma conta e2e_* nova (precisa da API no ar).
# E2E_BASE_URL=http://localhost:5180
# E2E_MAILPIT_URL=http://localhost:8025
# Token da prova de pessoa nos cadastros e logins feitos direto na API (padrão: o de teste da Cloudflare, que só vale
# com as chaves de teste do Turnstile na API local).
# E2E_HUMAN_TOKEN=
# E2E_EMAIL=
# E2E_PASSWORD=

# Token clássico do GitHub com read:packages para instalar @pedrolucaslopes/mixtape-ui do GitHub
# Packages no build do Docker. O npm não lê este arquivo: para `npm install` fora do Docker, a
# variável precisa estar no ambiente do terminal (e, estando lá, ela vale também para o compose).
NODE_AUTH_TOKEN=
