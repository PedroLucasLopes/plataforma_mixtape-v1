{
  "name": "mixtape-web",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Front do Mixtape: avalie álbuns e músicas, discos de nível, rankings e Awards.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && npm run check:locales && npm run check:icons && npm run check:testids && npm run build-only",
    "build-only": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check:testids": "node scripts/check-testids.mjs \"--scope=src/App.vue,,\" \"--scope=src/pages,page-,*Page\" \"--scope=src/layouts,layout-,*Layout\" \"--scope=src/components,,\"",
    "check:locales": "node scripts/check-locales.mjs src/locales --reference=pt-BR.json --sources=src",
    "generate:api": "node scripts/generate-api-types.mjs",
    "sync:icons": "node scripts/sync-icons.mjs",
    "check:icons": "node scripts/sync-icons.mjs --check",
    "analyze": "vite build --config vite.analyze.mts",
    "edge:plan": "node cloudflare/apply.mjs",
    "edge:apply": "node cloudflare/apply.mjs --apply",
    "test:edge": "node --test \"cloudflare/*.test.mjs\"",
    "prepare": "husky || exit 0"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@pedrolucaslopes/mixtape-auth": "^0.1.1",
    "@pedrolucaslopes/mixtape-ui": "^0.7.1",
    "@unhead/vue": "^3.4.2",
    "@vueuse/core": "^15.0.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.13",
    "vue-router": "^5.3.1",
    "vuetify": "^4.2.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@mdi/js": "^7.4.47",
    "@playwright/test": "^1.63.0",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.12.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.12.0",
    "eslint-config-vuetify": "^4.7.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.3",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  }
}
